PORT=5000
NODE_ENV=development
DATABASE_PATH=./database.sqlite
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

JWT_SECRET=replace-with-a-strong-secret
PHONE_LOOKUP_SECRET=replace-with-a-different-strong-secret
CLIENT_ORIGIN=http://localhost:3000
TRUST_PROXY=
JSON_BODY_LIMIT=256kb
UPLOAD_LIMIT_BYTES=5242880
STUDENT_LOOKUP_WINDOW_MS=900000
STUDENT_LOOKUP_MAX_FAILURES=8
ENABLE_TEST_LOGIN=false
LOAD_BUNDLED_DATA=false

ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_ROLE=SUPER_ADMIN

# Development/transition import only. Production should use the admin import or a college integration adapter.
STUDENT_ACCESS_RECORDS_JSON=[{"name":"Student Name","phoneNumber":"9000000000","universityRollNumber":"1250000000","section":"CSAI2B"}]
